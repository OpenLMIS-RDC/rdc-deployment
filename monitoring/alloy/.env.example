# Per-host values. The real file is <env>_env/alloy.env (or
# <env>_env/reporting/alloy.env for a reporting host) in rdc-configuration (it
# carries the ingest token); deploy_alloy.sh copies it here as .env.

DOCKER_HOST=tcp://uat.logimev.cd:2376

ALLOY_VERSION=v1.20.1

# Keep stable: config.alloy drops the agent's own logs by this project name.
COMPOSE_PROJECT_NAME=soldevelo-monitoring-agents

# Identity labels. environment is the monitoring enum (prod|uat|staging|dev).
# TARGET_NAME is rdc-<env>, or rdc-<env>-reporting on a reporting host.
APP=openlmis
DEPLOYMENT=rdc
ENVIRONMENT=uat
TARGET_NAME=rdc-uat

INGEST_METRICS_URL=https://olmis-monitoring.soldevelo.com/ingest/prometheus/api/v1/write
INGEST_LOGS_URL=https://olmis-monitoring.soldevelo.com/ingest/loki/loki/api/v1/push
# Must equal INGEST_TOKEN_RDC in the monitoring host's .env. Never commit it here.
INGEST_TOKEN=__set_in_rdc_configuration__

# Compose services whose container logs never leave the host.
LOG_DROP_SERVICES=

# postgres_exporter: set COMPOSE_PROFILES=postgres and the DSN of the read-only
# monitoring role (GRANT pg_monitor). The DSN carries a password — config repo
# only. App hosts only; leave empty on the reporting hosts.
COMPOSE_PROFILES=
PG_EXPORTER_DSN=postgresql://olmis_monitoring:__PASSWORD__@<rds-endpoint>:5432/open_lmis?sslmode=require
